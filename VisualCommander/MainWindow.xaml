<Window x:Class="VisualCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VisualCommander.Converters"
        
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Title="Visual CMD Studio — Constructor visual de línea de comandos"
        Icon="visualcmdstudio.ico"
        Height="880" Width="1560"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF5F5F5"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
        

    <Window.Resources>

        <!-- Converters -->
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>

        <!-- ==== Estilos para la apariencia CMD ==== -->

        <SolidColorBrush x:Key="CmdFondo"       Color="#0C0C0C"/>
        <SolidColorBrush x:Key="CmdCabecera"    Color="#1A1A1A"/>
        <SolidColorBrush x:Key="CmdBorde"       Color="#3A3A3A"/>
        <SolidColorBrush x:Key="CmdPrompt"      Color="#16C60C"/>
        <SolidColorBrush x:Key="CmdTexto"       Color="#CCCCCC"/>
        <SolidColorBrush x:Key="CmdAviso"       Color="#FFA500"/>
        <SolidColorBrush x:Key="CmdAcento"      Color="#4A90D9"/>

        <Style x:Key="CmdCabeceraTexto" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CmdAviso}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="CmdPromptTexto" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdPrompt}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NivelPeligroDirectorio}" Value="1">
                    <Setter Property="Foreground" Value="#FFFFD54F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NivelPeligroDirectorio}" Value="2">
                    <Setter Property="Foreground" Value="#FFE74C3C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CmdComandoTexto" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdTexto}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>


        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF1F4E79"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#FFE8F0F8"/>
        </Style>

        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Estilo para splitters horizontales (entre filas) -->
        <Style x:Key="SplitterHorizontal" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para splitters verticales (entre columnas) -->
        <Style x:Key="SplitterVertical" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==== Estilos para la línea activa / cerrada del cuerpo CMD ==== -->

        <Style x:Key="CmdLineaContenedor" TargetType="Border">
            <Setter Property="Padding" Value="12,3,12,3"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CmdTextoLinea" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdTexto}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CmdContadorLinea" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF5A5A5A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="OpButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <Style x:Key="BlockBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Null}" />
    </Window.InputBindings>


    <DockPanel>
        
        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nueva sesión" InputGestureText="Ctrl+N" Click="NuevaSesion_Click"/>
                <MenuItem Header="Abrir sesión..." InputGestureText="Ctrl+O" Click="AbrirSesion_Click"/>
                <MenuItem Header="Nuevo desde plantilla..." Click="NuevoDesdePlantilla_Click"/>
                <Separator/>
                <MenuItem Header="Guardar sesión" InputGestureText="Ctrl+S" Click="GuardarSesion_Click"/>
                <MenuItem Header="Guardar sesión como..." InputGestureText="Ctrl+Shift+S" Click="GuardarSesionComo_Click"/>
                <Separator/>
                <MenuItem Header="Importar desde archivo...">
                    <MenuItem Header="Desde .bat..." Click="ImportarDesdeBat_Click"/>
                    <MenuItem Header="Desde .cmd..." Click="ImportarDesdeCmd_Click"/>
                    <MenuItem Header="Desde .ps1..." Click="ImportarDesdePs1_Click"/>
                    <MenuItem Header="Desde .sh..." Click="ImportarDesdeSh_Click"/>
                </MenuItem>
                <MenuItem Header="Exportar como...">
                    <MenuItem Header=".bat — Batch de Windows" Click="GuardarBat_Click"/>
                    <MenuItem Header=".cmd — Script CMD" Click="GuardarCmd_Click"/>
                    <MenuItem Header=".ps1 — PowerShell" Click="GuardarPs1_Click"/>
                    <MenuItem Header=".sh — Bash (para revisión)" Click="GuardarSh_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Archivos recientes" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Salir" InputGestureText="Alt+F4" Click="Salir_Click"/>
            </MenuItem>


            <MenuItem Header="_Editar">
                <MenuItem Header="Deshacer" InputGestureText="Ctrl+Z" Click="Deshacer_Click"/>
                <MenuItem Header="Rehacer" InputGestureText="Ctrl+Y" Click="Rehacer_Click"/>
                <Separator/>
                <MenuItem Header="Cortar" InputGestureText="Ctrl+X" Click="Cortar_Click"/>
                <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="Copiar_Click"/>
                <MenuItem Header="Pegar" InputGestureText="Ctrl+V" Click="Pegar_Click"/>
                <Separator/>
                <MenuItem Header="Seleccionar todo" InputGestureText="Ctrl+A" Click="SeleccionarTodo_Click"/>
                <MenuItem Header="Buscar..." InputGestureText="Ctrl+F" Click="Buscar_Click"/>
                <MenuItem Header="Reemplazar..." InputGestureText="Ctrl+H" Click="Reemplazar_Click"/>
                <Separator/>
                <MenuItem Header="Insertar comando..." Click="InsertarComando_Click"/>
                <MenuItem Header="Insertar texto..." Click="InsertarTexto_Click"/>
                <MenuItem Header="Insertar ruta..." Click="InsertarRuta_Click"/>
            </MenuItem>

            <MenuItem Header="_Ver">
                <MenuItem Header="Panel izquierdo" IsCheckable="True" IsChecked="True" Click="VerPanelIzquierdo_Click"/>
                <MenuItem Header="Panel derecho" IsCheckable="True" IsChecked="True" Click="VerPanelDerecho_Click"/>
                <MenuItem Header="Panel inferior" IsCheckable="True" IsChecked="True" Click="VerPanelInferior_Click"/>
                <Separator/>
                <MenuItem Header="Constructor visual" IsCheckable="True" IsChecked="True" Click="VerConstructorVisual_Click"/>
                <MenuItem Header="Línea de comandos" IsCheckable="True" IsChecked="True" Click="VerLineaComandos_Click"/>
                <Separator/>
                <MenuItem Header="Tema">
                    <MenuItem Header="Claro" IsCheckable="True" IsChecked="True" Click="TemaClaro_Click"/>
                    <MenuItem Header="Oscuro" IsCheckable="True" Click="TemaOscuro_Click"/>
                    <MenuItem Header="Automático (sistema)" IsCheckable="True" Click="TemaAutomatico_Click"/>
                </MenuItem>
                <MenuItem Header="Zoom">
                    <MenuItem Header="100%" Click="Zoom100_Click"/>
                    <MenuItem Header="125%" Click="Zoom125_Click"/>
                    <MenuItem Header="150%" Click="Zoom150_Click"/>
                    <Separator/>
                    <MenuItem Header="Aumentar" InputGestureText="Ctrl++" Click="ZoomAumentar_Click"/>
                    <MenuItem Header="Disminuir" InputGestureText="Ctrl+-" Click="ZoomDisminuir_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Restablecer diseño de paneles" Click="RestablecerDiseno_Click"/>
                <MenuItem Header="Pantalla completa" InputGestureText="F11" Click="PantallaCompleta_Click"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem Header="Importar comandos..." Click="ImportarComandos_Click"/>
                <MenuItem Header="Insertar comando..." Click="InsertarComando_Click"/>
                <MenuItem Header="Editar catálogo de comandos..." Click="EditarCatalogo_Click"/>
                <MenuItem Header="Recargar catálogo" Click="RecargarCatalogo_Click"/>
                <Separator/>
                <MenuItem Header="Modo silencioso"
          IsCheckable="True"
          IsChecked="{Binding ModoSilencioso, Mode=TwoWay}"
          IsEnabled="{Binding EsModoExperto}"
          ToolTip="Silencia los avisos durante la construcción y edición. Disponible solo en modo experto."/>
                <Separator/>
                <MenuItem Header="Validar línea actual" InputGestureText="F6" Click="ValidarLinea_Click"/>
                <MenuItem Header="Ejecutar línea" InputGestureText="F5" Click="Ejecutar_Click"/>
                <Separator/>
                <MenuItem Header="Opciones..." Click="Opciones_Click"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="Documentación de comandos" InputGestureText="F1" Click="Documentacion_Click"/>
                <MenuItem Header="Guía de inicio rápido" Click="GuiaInicio_Click"/>
                <MenuItem Header="Atajos de teclado" Click="AtajosTeclado_Click"/>
                <Separator/>
                <MenuItem Header="Acerca de Visual CMD Studio..." Click="AcercaDe_Click"/>
            </MenuItem>
        </Menu>

        <!-- Barra de herramientas -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="▶ Ejecutar linea" Padding="8,2" ToolTip="Ejecutar la línea actual"
        Click="Ejecutar_Click"
        IsEnabled="{Binding EstaEjecutando, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="▶ Ejecutar plan" Padding="8,2"
FontWeight="SemiBold"
ToolTip="Ejecutar todas las líneas del plan (F5)"
Click="EjecutarPlan_Click"
IsEnabled="{Binding EstaEjecutando, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Content="⏹ Detener" Padding="8,2" ToolTip="Detener el proceso en curso"
                        Click="Detener_Click"
        IsEnabled="{Binding EstaEjecutando}"/>
                

                <CheckBox Content="Detener en error"
          VerticalAlignment="Center"
          Margin="8,0,0,0"
          IsChecked="{Binding DetenerEnError}"
          ToolTip="Si una línea falla, detener la ejecución del plan"/>
                <Separator/>
                <Button Content="💾 Guardar .bat" Padding="8,2"
        ToolTip="Exportar el plan como archivo batch"
        Click="GuardarBat_Click"/>
                <Button Content="📂 Abrir"           Padding="8,2" ToolTip="Abrir sesión guardada"/>
                <Separator/>
                <Button Content="🔍 Simular" Padding="8,2"
                        ToolTip="Previsualizar el efecto del comando sin ejecutarlo"
                         Click="Simular_Click"/>
                <Button Content="✔ Validar"          Padding="8,2" ToolTip="Validar sintaxis (F6)"/>
                <Button Content="🗑 Limpiar"         Padding="8,2" ToolTip="Limpiar la línea de comando"/>
                <Separator/>
                <Button Content="🔍 Zoom"            Padding="8,2" ToolTip="Ajustar tamaño de fuente"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Barra de estado -->
        <StatusBar DockPanel.Dock="Bottom">
           



            <StatusBarItem>
                <TextBlock x:Name="AvisoAdmin"
               Text="🛡 La línea activa requiere administrador"
               Foreground="#FFC0392B"
               FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineaActiva.RequiereAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusModo" Text="Modo: Comando a comando"/>
            </StatusBarItem>
            <Separator/>

                <!-- NUEVO: indicador de modo silencioso -->
                <StatusBarItem>
                    <TextBlock Text="🔇 Silencioso"
                   Foreground="#FFE67E22"
                   FontWeight="Bold"
                   ToolTip="Modo silencioso activo (silencia avisos de edición)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModoSilencioso}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StatusBarItem>

                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="Visual CMD Studio · C# · WPF · .NET 10"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Contenedor: contenido principal (arriba) + panel inferior (abajo) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"   MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="FilaInferior" Height="160" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Grid de las 3 columnas: le añadimos Grid.Row="0" -->
            <Grid Grid.Row="0">

                <!-- Contenido principal: tres columnas -->
        <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColumnIzquierda" Width="310" MinWidth="230"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition x:Name="ColumnCentral" Width="*" MinWidth="450"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition x:Name="ColumnDerecha" Width="330" MinWidth="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel izquierdo -->
                    <Grid x:Name="PanelIzquierdo" Grid.Column="0" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="90"/>
                            <!-- Modo de trabajo -->
                            <RowDefinition Height="5"/>
                            <!-- Separador -->
                            <RowDefinition Height=".4*"   MinHeight="40"/>
                            <!-- Buscador -->
                            <RowDefinition Height="5"/>
                            <!-- Separador -->
                            <RowDefinition Height="2*"   MinHeight="100"/>
                            <!-- Lista comandos -->
                            <RowDefinition Height="5"/>
                            <!-- Separador -->
                            <RowDefinition Height="Auto"   MinHeight="80"/>
                            <!-- Modificadores -->
                            <RowDefinition Height="5"/>
                            <!-- Separador -->
                            <RowDefinition Height="2*" MinHeight="120"/>
                            <!-- Árbol -->
                        </Grid.RowDefinitions>

                        <!-- ==== Modo de trabajo ==== -->
                        <Border Grid.Row="0" Style="{StaticResource Pane}" Margin="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="MODO DE TRABAJO" Style="{StaticResource SectionHeader}"/>

                                <RadioButton x:Name="RbModoAprendiz"
                     Content="Aprendiz (más ayuda)"
                     GroupName="ModoTrabajoGlobal"
                     Margin="10,4,8,2"
                     Checked="RbModoAprendiz_Checked"/>

                                <RadioButton x:Name="RbModoExperto"
                     Content="Experto (menos avisos)"
                     GroupName="ModoTrabajoGlobal"
                     Margin="10,2,8,6"
                     Checked="RbModoExperto_Checked"/>

                                <Separator Margin="10,2"/>

                                <CheckBox x:Name="ChkModoSilenciosoPanel"
                  Content="Modo silencioso"
                  Margin="10,2,8,6"
                  IsEnabled="{Binding EsModoExperto}"
                  IsChecked="{Binding ModoSilencioso, Mode=TwoWay}"
                  ToolTip="Silencia los avisos durante la edición. Solo en modo experto."/>
                            </StackPanel>
                        </Border>

                        <GridSplitter Grid.Row="1"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Buscador ==== -->
                        <Border Grid.Row="2" 
                                Style="{StaticResource Pane}" Margin="0,0,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CuadroBusqueda"
                     Grid.Column="0" Margin="4" Padding="4,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox x:Name="ComboOrden"
          Grid.Column="1" Margin="4" Width="95"
          SelectedIndex="{Binding OrdenSeleccionado, Mode=TwoWay}"
          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Por familia"/>
                                    <ComboBoxItem Content="A-Z"/>
                                    <ComboBoxItem Content="Frecuencia"/>
                                    </ComboBox>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="3"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Lista de comandos ==== -->
                        <Border Grid.Row="4" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                       Text="COMANDOS DISPONIBLES"
                       Style="{StaticResource SectionHeader}"/>

                                <ListBox x:Name="ListaComandos" Margin="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding ComandosView}"
                     SelectedItem="{Binding ComandoSeleccionado}"
                     MouseDoubleClick="ListaComandos_MouseDoubleClick"
                     KeyDown="ListaComandos_KeyDown"
                     PreviewMouseLeftButtonDown="ListaComandos_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ListaComandos_PreviewMouseMove">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="0,0,0,1"
                                        BorderBrush="#FFB0B0B0"
                                        Margin="0,8,0,4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#FF1F4E79"
                                               Margin="2,0,0,4"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ContenedorItem"
                                                    Background="Transparent"
                                                    
                                                    ToolTip= "Arrastra al constructor. Ctrl+Drag para sustituir."
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent"
                                                    CornerRadius="3"
                                                    Margin="0,1"
                                                    MouseEnter="ComandoCatalogo_MouseEnter"
                                                    MouseLeave="Token_MouseLeave">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                        Background="{Binding ColorFamilia, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="3,0,0,3"
                                        MinHeight="24"/>

                                                    <TextBlock Grid.Column="1"
                                           Text="{Binding Icono}"
                                           FontSize="14"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                           Text="{Binding TextoLista}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,4,0"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Peligroso}" Value="True">
                                                    <Setter TargetName="ContenedorItem"
                                                            
                                        Property="BorderBrush" Value="#FFC0392B"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="5"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Modificadores ==== -->
                        <Border Grid.Row="6" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                       Text="{Binding LineaActiva.TituloModificadores}"
                       Style="{StaticResource SectionHeader}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListaModificadores"
                              ItemsSource="{Binding LineaActiva.Modificadores}"
                              Margin="10,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ItemModificador"
                                    Background="Transparent"
                                    Padding="2,1"
                                    Cursor="Hand"
                                    MouseEnter="Modificador_MouseEnter"
                                    MouseLeave="Modificador_MouseLeave"
                                    PreviewMouseLeftButtonDown="Modificador_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Modificador_PreviewMouseMove">

                                                    <CheckBox Margin="0,2"
                                          Content="{Binding Descripcion, StringFormat='{}{0}'}"
                                          IsChecked="{Binding EstaSeleccionado, Mode=TwoWay}"
                                          IsEnabled="{Binding EstaBloqueado, Converter={StaticResource InverseBoolConverter}}"
                                          ToolTip="{Binding Descripcion}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="7"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Árbol de archivos ==== -->
                        <Border Grid.Row="8" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                       Text="EXPLORADOR DE ARCHIVOS"
                       Style="{StaticResource SectionHeader}"/>

                                <TreeView x:Name="ArbolArchivos" Margin="2"
                      AllowDrop="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Loaded="ArbolArchivos_Loaded"
                      PreviewMouseLeftButtonDown="ArbolArchivos_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="ArbolArchivos_PreviewMouseMove">

                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="False"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>

                                </TreeView>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" x:Name="SplitterIzquierdo"
                          Width="5"
                          Style="{StaticResource SplitterVertical}" 
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"/>

                    <!-- ============ PANEL CENTRAL ============ -->
                    <Grid x:Name="PanelCentral" Grid.Column="2" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="FilaConstructorVisual" Height="*" MinHeight="140"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition x:Name="FilaLineaComandos" Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>
                      

                    <!-- ==== Constructor visual (bloques arrastrables) ==== -->
                        <Border Grid.Row="0" Style="{StaticResource Pane}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="#FFE8F0F8">
                                    <TextBlock Text="CONSTRUCTOR VISUAL DEL COMANDO"
                           FontWeight="SemiBold" FontSize="11"
                           Foreground="#FF1F4E79"
                           Padding="8,5"
                           VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,3,6,3">
                                        <TextBlock Text="Línea:" VerticalAlignment="Center"
                               Margin="0,0,4,0" FontSize="11"/>
                                        <ComboBox x:Name="ComboLineas"
                              Width="200"
                              ItemsSource="{Binding Lineas}"
                              SelectedItem="{Binding LineaActiva}"
                              DisplayMemberPath="DisplayText"
                              VerticalContentAlignment="Center"/>
                                        
                                        
                                        <Button Content="Editar" Padding="8,2" FontSize="11" Margin="6,0,0,0" Click="MenuAcciones_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📋 Copiar" Command="{x:Null}" Click="CopiarLinea_Click"/>
                                                    <MenuItem Header="✂ Cortar" Click="CortarLinea_Click"/>
                                                    
                                                    <MenuItem Header="📌 Pegar" Click="PegarLinea_Click"
                      IsEnabled="{Binding PuedePegar}"/>
                                                    <Separator/>
                                                    <MenuItem Header="🔁 Duplicar" Click="DuplicarLinea_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="▲" Margin="4,0,0,0" Padding="8,2"
        FontSize="11"
        ToolTip="Mover la línea activa hacia arriba (Ctrl+Shift+↑)"
        Click="MoverArriba_Click"
        IsEnabled="{Binding PuedeSubirActiva}"/>
                                        <Button Content="▼" Margin="2,0,0,0" Padding="8,2"
        FontSize="11"
        ToolTip="Mover la línea activa hacia abajo (Ctrl+Shift+↓)"
        Click="MoverAbajo_Click"
        IsEnabled="{Binding PuedeBajarActiva}"/>

                                        <Button Content="➕ Nueva" Margin="6,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Crear una nueva línea de comandos"
                            Click="NuevaLinea_Click"/>
                                        <Button Content="✓ Cerrar" Margin="4,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Cerrar la línea activa sin crear una nueva"
                            Click="CerrarLinea_Click"/>
                                        <Button Content="🗑 Eliminar" Margin="4,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Eliminar la línea actual"
                            Click="EliminarLinea_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PanelBloques"
              ItemsSource="{Binding LineaActiva.BloquesVisibles}"
              Margin="8"
              AllowDrop="True"
              Background="Transparent"
              DragEnter="PanelBloques_DragEnter"
              DragOver="PanelBloques_DragOver"
              DragLeave="PanelBloques_DragLeave"
              Drop="PanelBloques_Drop"
              PreviewDrop="PanelBloques_PreviewDrop"
              ContextMenuOpening="PanelBloques_ContextMenuOpening">
                                        <ItemsControl.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="➕ Nueva línea" Click="ConstructorContext_NuevaLinea"/>
                                                <Separator/>
                                                <MenuItem Header="📌 Pegar token" 
                      Click="ConstructorContext_PegarToken"
                      IsEnabled="{Binding PuedePegarToken}"/>
                                                <Separator/>
                                                <MenuItem Header="➕ Insertar comando..." Click="ConstructorContext_InsertarComando"/>
                                                <MenuItem Header="➕ Insertar texto..." Click="ConstructorContext_InsertarTexto"/>
                                                <MenuItem Header="➕ Insertar ruta..." Click="ConstructorContext_InsertarRuta"/>
                                            </ContextMenu>
                                        </ItemsControl.ContextMenu>
                                
                                    <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    
                                                    <!-- ============ MODO DISPLAY ============ -->

                                                    <Border x:Name="BlockRoot"
        Style="{StaticResource BlockBase}"
        Background="{Binding Color, Converter={StaticResource HexToBrush}}"
        CornerRadius="3"
        BorderBrush="#FF666666"
        ToolTip="{Binding Descripcion}"
        Cursor="Hand"
        MouseEnter="Token_MouseEnter"
        MouseLeave="Token_MouseLeave"
        MouseLeftButtonDown="Token_MouseLeftButtonDown"
        PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Token_PreviewMouseMove"
        ContextMenuOpening="Token_ContextMenuOpening">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="✏ Editar token"
                      Tag="MostrarSiEditable"
                      Click="TokenContext_Editar"/>
                                                                <Separator/>
                                                                <MenuItem Header="📋 Copiar token" Click="TokenContext_Copiar"/>
                                                                <MenuItem Header="✂ Cortar token" Click="TokenContext_Cortar"/>
                                                                <MenuItem Header="📌 Pegar token" Click="TokenContext_Pegar"/>
                                                                <Separator/>
                                                                <MenuItem Header="🗑 Eliminar token" Click="TokenContext_Eliminar"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel Orientation="Horizontal">
                                                            
                                                            <TextBlock Text="{Binding Icono}"
                               FontSize="13"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                                                            
                                                            <TextBlock x:Name="TextoNormal"
           Text="{Binding TextoMostrado}"
           FontFamily="Consolas"
           FontSize="13"
           VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="IconoAdmin"
           Text="🛡"
           FontSize="11"
           Margin="4,0,0,0"
           VerticalAlignment="Center"
           Visibility="Collapsed"
           ToolTip="Requiere permisos de administrador"/>

                                                            <TextBlock x:Name="TextoDummie"
           Text="{Binding TextoDummy}"
           FontFamily="Consolas"
           FontSize="13"
           FontStyle="Italic"
           Foreground="#FF666666"
           VerticalAlignment="Center"
           Visibility="Collapsed"/>

                                                            <!-- Icono del lápiz (solo visible si es editable) -->
                                                            <TextBlock x:Name="IconoLapiz"
                               Text="✎"
                               FontSize="11"
                               Foreground="#FF555555"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="Collapsed"/>

                                                            <!-- Botón ✕ (aparece al pasar el ratón) -->
                                                            <Button x:Name="BtnEliminar"
                            Content="✕"
                            FontSize="10"
                            Width="16" Height="16"
                            Margin="8,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="Eliminar este bloque"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF666666"
                            Cursor="Hand"
                            Click="EliminarToken_Click"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ============ MODO EDICIÓN ============ -->
                                                    <Border x:Name="BlockEdicion"
                    Style="{StaticResource BlockBase}"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                    BorderBrush="#FF4A90D9"
                    BorderThickness="2"
                    CornerRadius="0,0,6,6"
                    Visibility="Collapsed">
                                                        <TextBox x:Name="EditorInPlace"
         Text="{Binding Texto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Style="{x:Null}"                                                    
         FontFamily="Consolas"
         FontSize="13"
         Foreground="#FF222222"
         Background="Transparent"
         BorderThickness="0"
         Padding="0"
         MinWidth="60"
         VerticalContentAlignment="Center"
         CaretBrush="#FF222222"
         IsReadOnly="False"
         IsEnabled="True"
         Focusable="True"
         GotFocus="EditorInPlace_GotFocus"                                                 
         PreviewKeyDown="EditorInPlace_PreviewKeyDown"
         LostFocus="EditorInPlace_LostFocus"
         IsVisibleChanged="EditorInPlace_IsVisibleChanged"
         ContextMenu="{x:Null}"/>
                                                    </Border>
                                                    <!-- ==== MODO EDICIÓN COMBOBOX (Constante/Comodín/Variable) ==== -->
                                                    <Border x:Name="BlockEdicionCombo"
        Style="{StaticResource BlockBase}"
        Background="{Binding Color, Converter={StaticResource HexToBrush}}"
        BorderBrush="#FF4A90D9"
        BorderThickness="2"
        CornerRadius="0,0,6,6"
        Visibility="Collapsed">
                                                        <ComboBox x:Name="ComboBoxEdicion"
              ItemsSource="{Binding ValoresDesplegable}"
              
              FontFamily="Consolas"
              FontSize="13"
              MinWidth="100"
              MaxDropDownHeight="240"
              Background="White"
              BorderThickness="0"
              IsEditable="True"
              PreviewKeyDown="ComboBoxEdicion_PreviewKeyDown"                                                 
              SelectionChanged="ComboBoxEdicion_SelectionChanged"
              DropDownClosed="ComboBoxEdicion_DropDownClosed"
              IsVisibleChanged="ComboBoxEdicion_IsVisibleChanged"/>
                                                    </Border>
                                                </Grid>

                                                <!-- ============ TRIGGERS ============ -->
                                                <DataTemplate.Triggers>
                                                    <!-- Hover: mostrar botón eliminar -->
                                                    <Trigger SourceName="BlockRoot"
                                                             
                     Property="IsMouseOver"
                     Value="True">
                                                        <Setter TargetName="BtnEliminar"
                        Property="Visibility"
                        Value="Visible"/>
                                                    </Trigger>

                                                    <!-- Token editable: esquina achaflanada + lápiz + tooltip extendido -->
                                                    <DataTrigger Binding="{Binding EsEditable}" Value="True">
                                                        <Setter TargetName="BlockRoot" Property="CornerRadius" Value="0,0,6,6"/>
                                                        <Setter TargetName="IconoLapiz" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip" Value = " {Binding Descripcion, StringFormat='{}{0}&#x0A;&#x0A;Doble clic para editar'}"/>
                                                    </DataTrigger>
                                                    <!-- Icono de administrador -->
                                                    <DataTrigger Binding="{Binding RequiereAdmin}" Value="True">
                                                        <Setter TargetName="IconoAdmin" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <!-- Modo edición SIN desplegable → TextBox -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EstoyEditando}" Value="True"/>
                                                            <Condition Binding="{Binding ValoresDesplegable, Converter={StaticResource NullToBool}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="BlockEdicion" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="BlockEdicionCombo" Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>

                                                    <!-- Modo edición CON desplegable → ComboBox -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EstoyEditando}" Value="True"/>
                                                            <Condition Binding="{Binding ValoresDesplegable, Converter={StaticResource NullToBool}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="BlockEdicion" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="BlockEdicionCombo" Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <!-- Dummies: borde punteado, texto apagado, cursiva, sin botón eliminar -->
                                                    <DataTrigger Binding="{Binding Estado}" Value="Dummy">
                                                        <Setter TargetName="TextoNormal" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="TextoDummie" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="BlockRoot" Property="Background" Value="#FFF0F0F0"/>
                                                        <Setter TargetName="BlockRoot" Property="BorderBrush" Value="#FFAAAAAA"/>
                                                        <Setter TargetName="BlockRoot" Property="BorderThickness" Value="1"/>
                                                        <Setter TargetName="BlockRoot" Property="Cursor" Value="Arrow"/>
                                                        <Setter TargetName="BtnEliminar" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="IconoLapiz" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Estado}" Value="Dummy"/>
                                                            <Condition Binding="{Binding EsRequerido}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Opacity" Value="0.75"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip"
            Value="{Binding Descripcion, StringFormat='Obligatorio: {0}'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Text"
            Value="{Binding TextoDummy, StringFormat='[{0}]'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Foreground" Value="#FF444444"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Estado}" Value="Dummy"/>
                                                            <Condition Binding="{Binding EsRequerido}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Opacity" Value="0.5"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip"
            Value="{Binding Descripcion, StringFormat='Opcional: {0}'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Text"
            Value="{Binding TextoDummy, StringFormat='({0})'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Foreground" Value="#FF888888"/>
                                                    </MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                            
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <!--== GridSplitter  entre bloques constructor y cmd ==-->
                        <GridSplitter Grid.Row="1" x:Name="SplitterCentral"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"/>

                        <!-- ==== Bloque CMD (línea de comandos resultante) ==== -->
                        <Border  Grid.Row="2" Style="{StaticResource Pane}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Cabecera SIMULACIÓN + estado -->
                                <Border Grid.Row="0"
                    Background="{StaticResource CmdCabecera}"
                    BorderBrush="{StaticResource CmdBorde}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource CmdAviso}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,6,0"/>
                                            <TextBlock Text="{Binding MensajeCmd}"
                                   Style="{StaticResource CmdCabeceraTexto}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,10,0">
                                            <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource CmdPrompt}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEjecutando}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource CmdAviso}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource CmdTexto}"
                                   VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="listo"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEjecutando}" Value="True">
                                                                <Setter Property="Text" Value="ejecutando..."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Barra de contexto: directorio de trabajo -->
                                <Border Grid.Row="1"
                    Background="#FF151515"
                    BorderBrush="{StaticResource CmdBorde}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                                        <TextBlock Text="Directorio de trabajo:"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#FF9A9A9A"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DirectorioTrabajo}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource CmdTexto}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"
                               ToolTip="{Binding DirectorioTrabajo}"/>
                                        <Button Content="Cambiar..."
                            Margin="10,0,0,0"
                            Padding="8,1"
                            FontSize="10"
                            Click="CambiarDirectorio_Click"
                            ToolTip="Seleccionar otro directorio de trabajo"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cuerpo CMD: lista de líneas + editor al final -->
                                <Border Grid.Row="2"
                    Background="{StaticResource CmdFondo}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,8,0,8">

                                            <!-- Todas las líneas del plan, apiladas -->
                                            <ItemsControl x:Name="PanelLineas" ItemsSource="{Binding Lineas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Borde superior animado -->
                                                            <Border x:Name="BordeSuperior"
                Grid.Row="0"
                Height="2"
                Background="{StaticResource CmdAcento}"
                HorizontalAlignment="Center"
                Width="0"/>

                                                            <!-- Contenido de la línea -->
                                                            <Border x:Name="LineaContenedor"
                Grid.Row="1"
                Padding="12,3,12,3"
                BorderThickness="4,0,0,0"
                BorderBrush="Transparent"
                Background="Transparent"
                Cursor="Hand"
                MouseLeftButtonDown="LineaClic_MouseLeftButtonDown">

                                                                <!-- ========== MENÚ CONTEXTUAL ========== -->
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Opened="LineaContextMenu_Opened">
                                                                        <MenuItem Header="Activar esta línea" Tag="MostrarSiNoActiva" Click="LineaContext_Activar"/>
                                                                        <MenuItem Header="✓ Cerrar línea" Tag="MostrarSiActiva" Click="LineaContext_Cerrar"/>

                                                                        <Separator/>

                                                                        <MenuItem Header="✂ Cortar línea" InputGestureText="Ctrl+X" Click="LineaContext_Cortar"/>
                                                                        <MenuItem Header="📋 Copiar línea" InputGestureText="Ctrl+C" Click="LineaContext_Copiar"/>
                                                                        <MenuItem Header="📌 Pegar línea" InputGestureText="Ctrl+V" Click="LineaContext_Pegar"/>
                                                                        <MenuItem Header="🔁 Duplicar línea" InputGestureText="Ctrl+D" Click="LineaContext_Duplicar"/>

                                                                        <Separator/>

                                                                        <MenuItem Header="▲ Mover arriba" InputGestureText="Ctrl+Shift+↑" Click="LineaContext_MoverArriba"/>
                                                                        <MenuItem Header="▼ Mover abajo" InputGestureText="Ctrl+Shift+↓" Click="LineaContext_MoverAbajo"/>

                                                                        <Separator/>

                                                                        <MenuItem Header="▶ Ejecutar esta línea" Click="LineaContext_Ejecutar"/>

                                                                        <Separator/>

                                                                        <MenuItem Header="🗑 Eliminar línea" Click="LineaContext_Eliminar"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>

                                                                <!-- ========== CONTENIDO ========== -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Indicador de estado -->
                                                                    <TextBlock Grid.Column="0"
                           Text="{Binding EstadoSimbolo}"
                           FontFamily="Consolas"
                           FontSize="14"
                           VerticalAlignment="Top"
                           Margin="0,2,8,0"
                           Foreground="{Binding EstadoColor, Converter={StaticResource HexToBrush}}"/>

                                                                    <!-- Prompt -->
                                                                    <TextBlock Grid.Column="0"
           Text="{Binding PromptCmdCorto}"
           ToolTip="{Binding DirectorioTrabajo}"
           Style="{StaticResource CmdPromptTexto}"
           VerticalAlignment="Top"
           Margin="24,2,8,2"
           ContextMenuOpening="Prompt_ContextMenuOpening">
                                                                        <TextBlock.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="Activar esta línea" Tag="MostrarSiNoActiva" Click="LineaContext_Activar"/>
                                                                                <Separator/>
                                                                                <MenuItem Header="✂ Cortar línea" InputGestureText="Ctrl+X" Click="LineaContext_Cortar"/>
                                                                                <MenuItem Header="📋 Copiar línea" InputGestureText="Ctrl+C" Click="LineaContext_Copiar"/>
                                                                                <MenuItem Header="📌 Pegar línea" InputGestureText="Ctrl+V" Click="LineaContext_Pegar"/>
                                                                                <MenuItem Header="🔁 Duplicar línea" InputGestureText="Ctrl+D" Click="LineaContext_Duplicar"/>
                                                                                <Separator/>
                                                                                <MenuItem Header="▲ Mover arriba" InputGestureText="Ctrl+Shift+↑" Click="LineaContext_MoverArriba"/>
                                                                                <MenuItem Header="▼ Mover abajo" InputGestureText="Ctrl+Shift+↓" Click="LineaContext_MoverAbajo"/>
                                                                                <Separator/>
                                                                                <MenuItem Header="▶ Ejecutar esta línea" Click="LineaContext_Ejecutar"/>
                                                                                <Separator/>
                                                                                <MenuItem Header="🗑 Eliminar línea" Click="LineaContext_Eliminar"/>
                                                                            </ContextMenu>
                                                                        </TextBlock.ContextMenu>
                                                                    </TextBlock>

                                                                    <!-- Comando: TextBox que envuelve -->
                                                                    <TextBox Grid.Column="1"
                         x:Name="TextoEdicion"
                         FontFamily="Consolas"
                         FontSize="14"
                         Foreground="{StaticResource CmdTexto}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,2,0,2"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Disabled"
                         CaretBrush="{StaticResource CmdTexto}"
                         Text="{Binding Texto, Mode=OneWay}"
                         IsUndoEnabled="False"
                         Visibility="Collapsed"
                         PreviewKeyDown="EditorComando_PreviewKeyDown"
                         LostFocus="EditorComando_LostFocus"
                         IsVisibleChanged="EditorComando_IsVisibleChanged"
                         ContextMenu="{Binding ContextMenu, ElementName=LineaContenedor}"/>

                                                                    <!-- Texto de lectura (modo no activo) -->
                                                                    <TextBlock Grid.Column="1"
                           x:Name="TextoLectura"
                           Text="{Binding Texto}"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="{StaticResource CmdTexto}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,2"/>
                                                                    
                                                                    <!-- X para elimiar la linea -->

                                                                    <Button x:Name="BtnEliminarLinea"
            Grid.Column="2"
            Content="✕"
            FontSize="11"
            Width="20" Height="20"
            Margin="6,0,0,0"
            Padding="0"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            ToolTip="Eliminar esta línea"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#FF888888"
            Cursor="Hand"
           
            PreviewMouseLeftButtonDown="EliminarLinea_PreviewMouseLeftButtonDown"/>

                                                                </Grid>
                                                            </Border>

                                                            <!-- Borde inferior animado -->
                                                            <Border x:Name="BordeInferior"
                Grid.Row="2"
                Height="2"
                Background="{StaticResource CmdAcento}"
                HorizontalAlignment="Center"
                Width="0"/>
                                                        </Grid>

                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                <!-- Contenedor -->
                                                                <Setter TargetName="LineaContenedor" Property="Background" Value="#FF181818"/>
                                                                <Setter TargetName="LineaContenedor" Property="BorderBrush" Value="{StaticResource CmdAcento}"/>

                                                                <!-- Intercambio lectura/edición -->
                                                                <Setter TargetName="TextoLectura" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="TextoEdicion" Property="Visibility" Value="Visible"/>

                                                                <!-- Bordes animados -->
                                                                <Setter TargetName="BordeSuperior" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="BordeInferior" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMouseOver, ElementName=LineaContenedor}" Value="True"/>
                                                                    <Condition Binding="{Binding EsActiva}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="BtnEliminarLinea" Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Editor de la línea activa -->
                                           

                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="3"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"            
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

              <GridSplitter Grid.Column="3" x:Name="SplitterDerecho" 
              Width="5"
              Style="{StaticResource SplitterVertical}" 
              ResizeDirection="Columns"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

                    <!-- Panel derecho -->
                    <Grid x:Name="PanelDerecho" Grid.Column="4" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="180"/>
                            <!-- Row 0: Comando activo -->
                            <RowDefinition Height="5"/>
                            <!-- Row 1: Splitter -->
                            <RowDefinition Height="1*" MinHeight="120"/>
                            <!-- Row 2: Detalle modificador -->
                            <RowDefinition Height="5"/>
                            <!-- Row 3: Splitter -->
                            <RowDefinition Height="2*" MinHeight="140"/>
                            <!-- Row 4: Operadores -->
                        </Grid.RowDefinitions>

                        <!-- ==== Row 0: Comando activo ==== -->
                        <Border Grid.Row="0" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                       Text="COMANDO ACTIVO"
                       Style="{StaticResource SectionHeader}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,8">

                                        <!-- Contenido cuando hay comando activo -->
                                        <StackPanel x:Name="PanelConComando">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LineaActiva.ComandoActivo}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Nombre e icono -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding LineaActiva.ComandoActivo.Icono}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding LineaActiva.ComandoActivo.Texto}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Descripción -->
                                            <TextBlock Text="{Binding LineaActiva.ComandoActivo.Descripcion}"
                                   TextWrapping="Wrap"
                                   Foreground="#FF333333"
                                   Margin="0,0,0,10"/>

                                            <!-- Sintaxis -->
                                            <TextBlock Text="Sintaxis:"
                                   FontWeight="SemiBold"
                                   Foreground="#FF666666"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                                            <Border Background="#FFF8F8F8"
                                BorderBrush="#FFDDDDDD"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,6"
                                Margin="0,0,0,10">
                                                <TextBlock Text="{Binding LineaActiva.ComandoActivo.Origen.Sintaxis}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="#FF222222"/>
                                            </Border>

                                            <!-- Ejemplos -->
                                            <TextBlock Text="Ejemplos:"
                                   FontWeight="SemiBold"
                                   Foreground="#FF666666"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding LineaActiva.ComandoActivo.Origen.Ejemplos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#FF444444"
                                               Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Mensaje cuando no hay comando activo -->
                                        <TextBlock x:Name="InfoSinComando"
                               Text="No hay ningún comando activo en esta línea.&#x0A;&#x0A;Selecciona un comando del catálogo o arrástralo al constructor."
                               TextWrapping="Wrap"
                               Foreground="#FF999999"
                               FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LineaActiva.ComandoActivo}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- ==== Splitter ==== -->
                        <GridSplitter Grid.Row="1"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Row 2: Detalle del modificador o token ==== -->
                        <Border Grid.Row="2" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock x:Name="TituloDetalle"
           DockPanel.Dock="Top"
           Text="DETALLE"
           Style="{StaticResource SectionHeader}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,8">

                                        <!-- Nombre del modificador -->
                                        <TextBlock x:Name="InfoModificadorNombre"
                               FontSize="14"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#FF1F4E79"
                               Visibility="Collapsed"/>

                                        <!-- Descripción -->
                                        <TextBlock x:Name="InfoModificadorDescripcion"
                               TextWrapping="Wrap"
                               Foreground="#FF333333"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>

                                        <!-- Valores posibles -->
                                        <StackPanel x:Name="PanelValoresPosibles"
                                Margin="0,8,0,0"
                                Visibility="Collapsed">
                                            <TextBlock Text="Valores posibles:"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="#FF666666"
                                   Margin="0,0,0,4"/>
                                            <TextBlock x:Name="InfoModificadorValores"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#FF444444"
                                   TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Mensaje cuando no hay hover -->
                                        <TextBlock x:Name="InfoSinModificador"
                               Text="Pasa el ratón sobre un modificador o un token en el constructor para ver su descripción detallada."
                               TextWrapping="Wrap"
                               Foreground="#FF999999"
                               FontStyle="Italic"/>

                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        

                        <!-- ==== Splitter ==== -->
                        <GridSplitter Grid.Row="3"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                        <!-- ==== Row 4: Operadores/Variables/Constantes ==== -->
                        <Border Grid.Row="4" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                       Text="INSERTAR TOKENS"
                       Style="{StaticResource SectionHeader}"/>
                                <TabControl Margin="4,2">
                                   <TabItem>
    <TabItem.Header>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="📝" Margin="0,0,4,0"/>
            <TextBlock Text="Texto"/>
        </StackPanel>
    </TabItem.Header>
    <StackPanel Margin="8">
        <TextBlock Text="Escribe el texto a insertar:"
                   FontSize="11"
                   Foreground="#FF666666"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="TxtTextoLibre"
                 Padding="6,4"
                 FontFamily="Consolas"
                 FontSize="12"
                 VerticalContentAlignment="Center"
                 KeyDown="TxtTextoLibre_KeyDown"
                 ToolTip="Pulsa Enter para insertar el texto"/>

        <Button Content="📝 Insertar texto"
                Padding="10,6"
                FontSize="12"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                Click="InsertarTextoLibre_Click"
                ToolTip="Inserta el texto entre comillas al final de la línea"/>

        <TextBlock Text="Texto con espacios se entrecomilla automáticamente."
                   FontSize="10"
                   Foreground="#FF999999"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,6,0,12"/>

        <Separator Margin="0,0,0,8"/>

        <Button Content="◇ Insertar token vacío"
                Padding="10,6"
                FontSize="11"
                HorizontalAlignment="Left"
                Click="AgregarTexto_Click"
                ToolTip="Inserta un token vacío para editar después"/>

        <TextBlock Text="El token vacío se abre para editar directamente. Útil como placeholder."
                   FontSize="10"
                   Foreground="#FF999999"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>
    </StackPanel>
</TabItem>

                                    <TabItem Header="Operadores">
                                        <ListBox x:Name="ListaOperadores" Margin="4"
             ItemsSource="{Binding CatalogoTokens.Operadores}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="ToolTip" Value="Insertar en la línea. Ctrl+Drag para sustituir."/>
                                                    <Setter Property="Padding" Value="2"/>
                                                    <Setter Property="Margin" Value="2"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="ToolTip" Value="Insertar en la línea. Ctrl+Drag para sustituir."/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF0F0F0"
                        BorderBrush="#FFCCCCCC"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,4"
                        MinWidth="40"
                        Cursor="Hand"
                        MouseEnter="TokenInfo_MouseEnter"
                        MouseLeave="TokenInfo_MouseLeave"
                        PreviewMouseLeftButtonDown="Operador_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="BotonTexto_PreviewMouseMove">
                                                        <TextBlock Text="{Binding Nombre}"
                               FontFamily="Consolas"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                    <TabItem Header="Variables">
                                        <ListBox x:Name="ListaVariables"
                                            Margin="4"
                                            ItemsSource="{Binding CatalogoTokens.Variables}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                        Padding="2,1"
                                                        Cursor="Hand"
                                                        ToolTip="Insertar en la línea. Ctrl+Drag para sustituir."
                                                        MouseEnter="TokenInfo_MouseEnter"
                                                        MouseLeave="TokenInfo_MouseLeave"
                                                        PreviewMouseLeftButtonDown="Variable_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="BotonTexto_PreviewMouseMove" >
                                                        <TextBlock Text="{Binding Nombre}"
                                                        FontFamily="Consolas"
                                                        FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem Header="Constantes">
                                        <ListBox x:Name="ListaConstantes"
                                            Margin="4"
                                            ItemsSource="{Binding CatalogoTokens.Constantes}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                        Padding="2,1"
                                                        Cursor="Hand"
                                                        ToolTip="Insertar en la línea. Ctrl+Drag para sustituir."    
                                                        MouseEnter="TokenInfo_MouseEnter"
                                                        MouseLeave="TokenInfo_MouseLeave"
                                                        PreviewMouseLeftButtonDown="Variable_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="BotonTexto_PreviewMouseMove" >
                                                        <TextBlock Text="{Binding Nombre}"
                                                            FontFamily="Consolas"
                                                            FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem Header="Comodines">
                                        <ListBox x:Name="ListaComodines"
                                            Margin="4"
                                            ItemsSource="{Binding CatalogoTokens.Comodines}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                        Padding="2,1"
                                                        Cursor="Hand"
                                                        ToolTip="Insertar en la línea. Ctrl+Drag para sustituir."   
                                                        MouseEnter="TokenInfo_MouseEnter"
                                                        MouseLeave="TokenInfo_MouseLeave"
                                                        PreviewMouseLeftButtonDown="Variable_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="BotonTexto_PreviewMouseMove">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Nombre}"
                                                                FontFamily="Consolas"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                MinWidth="60"/>
                                                            <TextBlock Text="{Binding Descripcion}"
                                                                FontSize="11"
                                                                Foreground="#FF666666"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                   
                                </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Splitter horizontal del panel inferior-->
            <GridSplitter Grid.Row="1" x:Name="SplitterInferior"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"/>

            <!-- Panel inferior: comentarios, errores, salida, historial -->
            <Border Grid.Row="2" x:Name="PanelInferior"
            BorderBrush="#FFC8C8C8" BorderThickness="0,1,0,0"
            Background="White">
                <TabControl>
                    <TabItem Header="💬 Comentarios">
                        <TextBox x:Name="TextoComentarios" AcceptsReturn="True"
                         Margin="4" Padding="6"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
                    </TabItem>
                    <TabItem Header="⚠ Errores">
                        <DataGrid x:Name="GridErrores" Margin="4" AutoGenerateColumns="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravedad" Binding="{Binding Severidad}" Width="90"/>
                                <DataGridTextColumn Header="Mensaje"  Binding="{Binding Mensaje}"   Width="*"/>
                                <DataGridTextColumn Header="Línea"    Binding="{Binding Linea}"     Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="📤 Salida">
                        <ListBox x:Name="ListaSalida"
             ItemsSource="{Binding Salida}"
             Background="#FF0C0C0C"
             Foreground="#FFDCDCDC"
             FontFamily="Consolas"
             FontSize="12"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFDCDCDC"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                           FontFamily="Consolas"
                           TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="🕘 Historial">
                        <ListBox x:Name="ListaHistorial" Margin="4"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    
    </DockPanel>
    
</Window>