<Window x:Class="VisualCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VisualCommander.Converters"
        
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Title="Visual CMD Studio — Constructor visual de línea de comandos"
        Height="880" Width="1560"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF5F5F5"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
        

    <Window.Resources>

        <!-- Converters -->
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- ==== Estilos para la apariencia CMD ==== -->

        <SolidColorBrush x:Key="CmdFondo"       Color="#0C0C0C"/>
        <SolidColorBrush x:Key="CmdCabecera"    Color="#1A1A1A"/>
        <SolidColorBrush x:Key="CmdBorde"       Color="#3A3A3A"/>
        <SolidColorBrush x:Key="CmdPrompt"      Color="#16C60C"/>
        <SolidColorBrush x:Key="CmdTexto"       Color="#CCCCCC"/>
        <SolidColorBrush x:Key="CmdAviso"       Color="#FFA500"/>
        <SolidColorBrush x:Key="CmdAcento"      Color="#4A90D9"/>

        <Style x:Key="CmdCabeceraTexto" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CmdAviso}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="CmdPromptTexto" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdPrompt}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NivelPeligroDirectorio}" Value="1">
                    <Setter Property="Foreground" Value="#FFFFD54F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NivelPeligroDirectorio}" Value="2">
                    <Setter Property="Foreground" Value="#FFE74C3C"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CmdComandoTexto" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdTexto}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>


        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF1F4E79"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#FFE8F0F8"/>
        </Style>

        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Estilo para splitters horizontales (entre filas) -->
        <Style x:Key="SplitterHorizontal" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para splitters verticales (entre columnas) -->
        <Style x:Key="SplitterVertical" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==== Estilos para la línea activa / cerrada del cuerpo CMD ==== -->

        <Style x:Key="CmdLineaContenedor" TargetType="Border">
            <Setter Property="Padding" Value="12,3,12,3"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CmdTextoLinea" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CmdTexto}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CmdContadorLinea" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF5A5A5A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="OpButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <Style x:Key="BlockBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{x:Null}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Null}" />
    </Window.InputBindings>


    <DockPanel>
        
        <!-- Menú superior -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nueva sesión" InputGestureText="Ctrl+N" Click="NuevaSesion_Click"/>
                <MenuItem Header="Abrir sesión..." InputGestureText="Ctrl+O" Click="AbrirSesion_Click"/>
                <Separator/>
                <MenuItem Header="Guardar sesión" InputGestureText="Ctrl+S" Click="GuardarSesion_Click"/>
                <MenuItem Header="Guardar sesión como..." Click="GuardarSesionComo_Click"/>
                <Separator/>
                <MenuItem Header="Exportar como .bat..." Click="GuardarBat_Click"/>
                <MenuItem Header="Exportar como .ps1..." IsEnabled="False"/>
                <MenuItem Header="Exportar como .cmd..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Salir" InputGestureText="Alt+F4" Click="Salir_Click"/>
            </MenuItem>

            <MenuItem Header="_Editar">
                <MenuItem Header="Deshacer"              InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Rehacer"               InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cortar"                InputGestureText="Ctrl+X"/>
                <MenuItem Header="Copiar"                InputGestureText="Ctrl+C"/>
                <MenuItem Header="Pegar"                 InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Limpiar línea de comando"/>
                <MenuItem Header="Limpiar constructor visual"/>
            </MenuItem>

            <MenuItem Header="_Ver">
                <MenuItem Header="Panel izquierdo"  IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Panel central"    IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Panel derecho"    IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Panel inferior"   IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="Tema claro"       IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Tema oscuro"      IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="Restablecer diseño de paneles"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem Header="Editor de catálogo de comandos..."/>
                <MenuItem Header="Recargar catálogo"/>
                <Separator/>
                <MenuItem Header="Modo silencioso"
              IsCheckable="True"
              IsChecked="{Binding ModoSilencioso, Mode=TwoWay}"
              ToolTip="Silencia los avisos durante la construcción y edición. No afecta a los avisos antes de ejecutar."/>
                <Separator/>
                <MenuItem Header="Validar línea actual"  InputGestureText="F6"/>
                <MenuItem Header="Ejecutar"              InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="Opciones..."/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="Documentación de comandos" InputGestureText="F1"/>
                <MenuItem Header="Atajos de teclado"/>
                <Separator/>
                <MenuItem Header="Acerca de Visual CMD Studio..."/>
            </MenuItem>
        </Menu>

        <!-- Barra de herramientas -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="▶ Ejecutar linea" Padding="8,2" ToolTip="Ejecutar la línea actual"
        Click="Ejecutar_Click"
        IsEnabled="{Binding EstaEjecutando, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="▶ Ejecutar plan" Padding="8,2"
FontWeight="SemiBold"
ToolTip="Ejecutar todas las líneas del plan (F5)"
Click="EjecutarPlan_Click"
IsEnabled="{Binding EstaEjecutando, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Content="⏹ Detener" Padding="8,2" ToolTip="Detener el proceso en curso"
                        Click="Detener_Click"
        IsEnabled="{Binding EstaEjecutando}"/>
                

                <CheckBox Content="Detener en error"
          VerticalAlignment="Center"
          Margin="8,0,0,0"
          IsChecked="{Binding DetenerEnError}"
          ToolTip="Si una línea falla, detener la ejecución del plan"/>
                <Separator/>
                <Button Content="💾 Guardar .bat" Padding="8,2"
        ToolTip="Exportar el plan como archivo batch"
        Click="GuardarBat_Click"/>
                <Button Content="📂 Abrir"           Padding="8,2" ToolTip="Abrir sesión guardada"/>
                <Separator/>
                <Button Content="🔍 Simular" Padding="8,2"
                        ToolTip="Previsualizar el efecto del comando sin ejecutarlo"
                         Click="Simular_Click"/>
                <Button Content="✔ Validar"          Padding="8,2" ToolTip="Validar sintaxis (F6)"/>
                <Button Content="🗑 Limpiar"         Padding="8,2" ToolTip="Limpiar la línea de comando"/>
                <Separator/>
                <Button Content="🔍 Zoom"            Padding="8,2" ToolTip="Ajustar tamaño de fuente"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Barra de estado -->
        <StatusBar DockPanel.Dock="Bottom">
           
            
           
            <StatusBarItem>
                <TextBlock x:Name="AvisoAdmin"
               Text="🛡 La línea activa requiere administrador"
               Foreground="#FFC0392B"
               FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LineaActiva.RequiereAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusModo" Text="Modo: Comando a comando"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Visual CMD Studio · C# · WPF · .NET 10"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Contenedor: contenido principal (arriba) + panel inferior (abajo) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"   MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="160" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Grid de las 3 columnas: le añadimos Grid.Row="0" -->
            <Grid Grid.Row="0">

                <!-- Contenido principal: tres columnas -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="230"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="450"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="330" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo -->
            <Grid Grid.Column="0" Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"   MinHeight="120"/>
                    <!-- Lista    -->
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1*"   MinHeight="60"/>
                    <!-- Descrip. -->
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1.5*" MinHeight="80"/>
                    <!-- Árbol    -->
                </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Pane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                   Text="{Binding LineaActiva.TituloModificadores}"
                   Style="{StaticResource SectionHeader}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListaModificadores"
                                        ItemsSource="{Binding LineaActiva.Modificadores}"
                                        Margin="10,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ItemModificador"
                    Background="Transparent"
                    Padding="2,1"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="Modificador_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Modificador_PreviewMouseMove">
                                                    <CheckBox Margin="0,2"
                          Content="{Binding Descripcion, StringFormat='{}{0}'}"
                          IsChecked="{Binding EstaSeleccionado, Mode=TwoWay}"
                          IsEnabled="{Binding EstaBloqueado, Converter={StaticResource InverseBoolConverter}}"
                          ToolTip="{Binding Descripcion}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Pane}" Margin="0,0,0,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CuadroBusqueda"
                            Grid.Column="0" Margin="4" Padding="4,3"
                            VerticalContentAlignment="Center"
                            Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox x:Name="ComboOrden"
                                  Grid.Column="1" Margin="4" Width="95"
                                  SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Por familia"/>
                            <ComboBoxItem Content="A-Z"/>
                            <ComboBoxItem Content="Frecuencia"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Pane}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="COMANDOS DISPONIBLES"
                                   Style="{StaticResource SectionHeader}"/>

                                <ListBox x:Name="ListaComandos" Margin="2"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ItemsSource="{Binding ComandosView}"
                                    SelectedItem="{Binding ComandoSeleccionado}"
                                    MouseDoubleClick="ListaComandos_MouseDoubleClick"
                                    KeyDown="ListaComandos_KeyDown"
                                    PreviewMouseLeftButtonDown="ListaComandos_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ListaComandos_PreviewMouseMove">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="0,0,0,1"
                            BorderBrush="#FFB0B0B0"
                            Margin="0,8,0,4">
                                                        <TextBlock Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#FF1F4E79"
                                   Margin="2,0,0,4"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ContenedorItem"
                    BorderThickness="2"
                    BorderBrush="Transparent"
                    CornerRadius="3"
                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                            Background="{Binding ColorFamilia, Converter={StaticResource HexToBrush}}"
                                                          CornerRadius="3,0,0,3"
                            MinHeight="24"/>

                                                    <TextBlock Grid.Column="1"
                               Text="{Binding Icono}"
                               FontSize="14"
                               Margin="10,0,8,0"
                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                               Text="{Binding TextoLista}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,4,0"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Peligroso}" Value="True">
                                                    <Setter TargetName="ContenedorItem"
                                                            Property="BorderBrush" Value="#FFC0392B"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="3"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"       
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

                <Border Grid.Row="4" Style="{StaticResource Pane}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="DESCRIPCIÓN DEL COMANDO"
                                   Style="{StaticResource SectionHeader}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TextoDescripcion"
                                Margin="8" TextWrapping="Wrap"
                                Foreground="#FF333333"
                                Text="{Binding TextoDescripcion}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="5"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

                <Border Grid.Row="6" Style="{StaticResource Pane}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="EXPLORADOR DE ARCHIVOS"
                                   Style="{StaticResource SectionHeader}"/>
                                <TreeView x:Name="ArbolArchivos" Margin="2"
                                         AllowDrop="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        Loaded="ArbolArchivos_Loaded"
                                        PreviewMouseLeftButtonDown="ArbolArchivos_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ArbolArchivos_PreviewMouseMove">
                                          
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="False"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" 
                          Width="5"
                          Style="{StaticResource SplitterVertical}" 
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"/>

                    <!-- ============ PANEL CENTRAL ============ -->
                    <Grid Grid.Column="2" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"   MinHeight="140"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"   MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- ==== Constructor visual (bloques arrastrables) ==== -->
                        <Border Grid.Row="0" Style="{StaticResource Pane}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="#FFE8F0F8">
                                    <TextBlock Text="CONSTRUCTOR VISUAL DEL COMANDO"
                           FontWeight="SemiBold" FontSize="11"
                           Foreground="#FF1F4E79"
                           Padding="8,5"
                           VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,3,6,3">
                                        <TextBlock Text="Línea:" VerticalAlignment="Center"
                               Margin="0,0,4,0" FontSize="11"/>
                                        <ComboBox x:Name="ComboLineas"
                              Width="200"
                              ItemsSource="{Binding Lineas}"
                              SelectedItem="{Binding LineaActiva}"
                              DisplayMemberPath="DisplayText"
                              VerticalContentAlignment="Center"/>
                                        
                                        
                                        <Button Content="Editar" Padding="8,2" FontSize="11" Margin="6,0,0,0" Click="MenuAcciones_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📋 Copiar" Command="{x:Null}" Click="CopiarLinea_Click"/>
                                                    <MenuItem Header="✂ Cortar" Click="CortarLinea_Click"/>
                                                    <MenuItem Header="📌 Pegar" Click="PegarLinea_Click"
                      IsEnabled="{Binding PuedePegar}"/>
                                                    <Separator/>
                                                    <MenuItem Header="🔁 Duplicar" Click="DuplicarLinea_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="▲" Margin="4,0,0,0" Padding="8,2"
        FontSize="11"
        ToolTip="Mover la línea activa hacia arriba (Ctrl+Shift+↑)"
        Click="MoverArriba_Click"
        IsEnabled="{Binding PuedeSubirActiva}"/>
                                        <Button Content="▼" Margin="2,0,0,0" Padding="8,2"
        FontSize="11"
        ToolTip="Mover la línea activa hacia abajo (Ctrl+Shift+↓)"
        Click="MoverAbajo_Click"
        IsEnabled="{Binding PuedeBajarActiva}"/>

                                        <Button Content="➕ Nueva" Margin="6,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Crear una nueva línea de comandos"
                            Click="NuevaLinea_Click"/>
                                        <Button Content="✓ Cerrar" Margin="4,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Cerrar la línea activa sin crear una nueva"
                            Click="CerrarLinea_Click"/>
                                        <Button Content="🗑 Eliminar" Margin="4,0,0,0" Padding="8,2"
                            FontSize="11"
                            ToolTip="Eliminar la línea actual"
                            Click="EliminarLinea_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PanelBloques"
                              ItemsSource="{Binding LineaActiva.BloquesVisibles}"
                              Margin="8"
                              AllowDrop="True"
                              Background="Transparent"
                              DragEnter="PanelBloques_DragEnter"
                              DragOver="PanelBloques_DragOver"
                              DragLeave="PanelBloques_DragLeave"
                              Drop="PanelBloques_Drop">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    
                                                    <!-- ============ MODO DISPLAY ============ -->
                                                    <Border x:Name="BlockRoot"
                    Style="{StaticResource BlockBase}"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                    CornerRadius="3"
                    BorderBrush="#FF666666"
                    ToolTip="{Binding Descripcion}"
                    Cursor="Hand"
                    MouseLeftButtonDown="Token_MouseLeftButtonDown">
                                                        <StackPanel Orientation="Horizontal">
                                                            
                                                            <TextBlock Text="{Binding Icono}"
                               FontSize="13"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                                                            
                                                            <TextBlock x:Name="TextoNormal"
           Text="{Binding TextoMostrado}"
           FontFamily="Consolas"
           FontSize="13"
           VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="IconoAdmin"
           Text="🛡"
           FontSize="11"
           Margin="4,0,0,0"
           VerticalAlignment="Center"
           Visibility="Collapsed"
           ToolTip="Requiere permisos de administrador"/>

                                                            <TextBlock x:Name="TextoDummie"
           Text="{Binding TextoDummy}"
           FontFamily="Consolas"
           FontSize="13"
           FontStyle="Italic"
           Foreground="#FF666666"
           VerticalAlignment="Center"
           Visibility="Collapsed"/>

                                                            <!-- Icono del lápiz (solo visible si es editable) -->
                                                            <TextBlock x:Name="IconoLapiz"
                               Text="✎"
                               FontSize="11"
                               Foreground="#FF555555"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="Collapsed"/>

                                                            <!-- Botón ✕ (aparece al pasar el ratón) -->
                                                            <Button x:Name="BtnEliminar"
                            Content="✕"
                            FontSize="10"
                            Width="16" Height="16"
                            Margin="8,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="Eliminar este bloque"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF666666"
                            Cursor="Hand"
                            Click="EliminarToken_Click"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ============ MODO EDICIÓN ============ -->
                                                    <Border x:Name="BlockEdicion"
                    Style="{StaticResource BlockBase}"
                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                    BorderBrush="#FF4A90D9"
                    BorderThickness="2"
                    CornerRadius="0,0,6,6"
                    Visibility="Collapsed">
                                                        <TextBox x:Name="EditorInPlace"
         Text="{Binding Texto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Style="{x:Null}"                                                    
         FontFamily="Consolas"
         FontSize="13"
         Foreground="#FF222222"
         Background="Transparent"
         BorderThickness="0"
         Padding="0"
         MinWidth="60"
         VerticalContentAlignment="Center"
         CaretBrush="#FF222222"
         IsReadOnly="False"
         IsEnabled="True"
         Focusable="True"
         GotFocus="EditorInPlace_GotFocus"                                                 
         PreviewKeyDown="EditorInPlace_PreviewKeyDown"
         LostFocus="EditorInPlace_LostFocus"
         IsVisibleChanged="EditorInPlace_IsVisibleChanged"/>
                                                    </Border>
                                                </Grid>

                                                <!-- ============ TRIGGERS ============ -->
                                                <DataTemplate.Triggers>
                                                    <!-- Hover: mostrar botón eliminar -->
                                                    <Trigger SourceName="BlockRoot"
                                                             
                     Property="IsMouseOver"
                     Value="True">
                                                        <Setter TargetName="BtnEliminar"
                        Property="Visibility"
                        Value="Visible"/>
                                                    </Trigger>

                                                    <!-- Token editable: esquina achaflanada + lápiz + tooltip extendido -->
                                                    <DataTrigger Binding="{Binding EsEditable}" Value="True">
                                                        <Setter TargetName="BlockRoot" Property="CornerRadius" Value="0,0,6,6"/>
                                                        <Setter TargetName="IconoLapiz" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip" Value = " {Binding Descripcion, StringFormat='{}{0}&#x0A;&#x0A;Doble clic para editar'}"/>
                                                    </DataTrigger>
                                                    <!-- Icono de administrador -->
                                                    <DataTrigger Binding="{Binding RequiereAdmin}" Value="True">
                                                        <Setter TargetName="IconoAdmin" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <!-- Modo edición: mostrar BlockEdicion, ocultar BlockRoot -->
                                                    <DataTrigger Binding="{Binding EstoyEditando}" Value="True">
                                                        <Setter TargetName="BlockRoot" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="BlockEdicion" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <!-- Dummies: borde punteado, texto apagado, cursiva, sin botón eliminar -->
                                                    <DataTrigger Binding="{Binding Estado}" Value="Dummy">
                                                        <Setter TargetName="TextoNormal" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="TextoDummie" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="BlockRoot" Property="Background" Value="#FFF0F0F0"/>
                                                        <Setter TargetName="BlockRoot" Property="BorderBrush" Value="#FFAAAAAA"/>
                                                        <Setter TargetName="BlockRoot" Property="BorderThickness" Value="1"/>
                                                        <Setter TargetName="BlockRoot" Property="Cursor" Value="Arrow"/>
                                                        <Setter TargetName="BtnEliminar" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="IconoLapiz" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Estado}" Value="Dummy"/>
                                                            <Condition Binding="{Binding EsRequerido}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Opacity" Value="0.75"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip"
            Value="{Binding Descripcion, StringFormat='Obligatorio: {0}'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Text"
            Value="{Binding TextoDummy, StringFormat='[{0}]'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Foreground" Value="#FF444444"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Estado}" Value="Dummy"/>
                                                            <Condition Binding="{Binding EsRequerido}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BlockRoot" Property="Opacity" Value="0.5"/>
                                                        <Setter TargetName="BlockRoot" Property="ToolTip"
            Value="{Binding Descripcion, StringFormat='Opcional: {0}'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Text"
            Value="{Binding TextoDummy, StringFormat='({0})'}"/>
                                                        <Setter TargetName="TextoDummie" Property="Foreground" Value="#FF888888"/>
                                                    </MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                            
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="1"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"/>

                        <!-- ==== Bloque CMD (línea de comandos resultante) ==== -->
                        <Border Grid.Row="2" Style="{StaticResource Pane}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Cabecera SIMULACIÓN + estado -->
                                <Border Grid.Row="0"
                    Background="{StaticResource CmdCabecera}"
                    BorderBrush="{StaticResource CmdBorde}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource CmdAviso}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,6,0"/>
                                            <TextBlock Text="{Binding MensajeCmd}"
                                   Style="{StaticResource CmdCabeceraTexto}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,10,0">
                                            <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource CmdPrompt}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEjecutando}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource CmdAviso}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource CmdTexto}"
                                   VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="listo"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEjecutando}" Value="True">
                                                                <Setter Property="Text" Value="ejecutando..."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Barra de contexto: directorio de trabajo -->
                                <Border Grid.Row="1"
                    Background="#FF151515"
                    BorderBrush="{StaticResource CmdBorde}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                                        <TextBlock Text="Directorio de trabajo:"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#FF9A9A9A"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DirectorioTrabajo}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource CmdTexto}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"
                               ToolTip="{Binding DirectorioTrabajo}"/>
                                        <Button Content="Cambiar..."
                            Margin="10,0,0,0"
                            Padding="8,1"
                            FontSize="10"
                            Click="CambiarDirectorio_Click"
                            ToolTip="Seleccionar otro directorio de trabajo"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cuerpo CMD: lista de líneas + editor al final -->
                                <Border Grid.Row="2"
                    Background="{StaticResource CmdFondo}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,8,0,8">

                                            <!-- Todas las líneas del plan, apiladas -->
                                            <ItemsControl x:Name="PanelLineas" ItemsSource="{Binding Lineas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Borde superior animado -->
                                                            <Border x:Name="BordeSuperior"
                        Grid.Row="0"
                        Height="2"
                        Background="{StaticResource CmdAcento}"
                        HorizontalAlignment="Center"
                        Width="0"/>

                                                            <!-- Contenido de la línea -->
                                                            <Border x:Name="LineaContenedor"
                        Grid.Row="1"
                        Padding="12,3,12,3"
                        BorderThickness="4,0,0,0"
                        BorderBrush="Transparent"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="LineaClic_MouseLeftButtonDown">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Indicador de estado (si lo tienes) -->
                                                                    <TextBlock Grid.Column="0"
               Text="{Binding EstadoSimbolo}"
               FontFamily="Consolas"
               FontSize="14"
               VerticalAlignment="Top"
               Margin="0,2,8,0"
               Foreground="{Binding EstadoColor, Converter={StaticResource HexToBrush}}"/>

                                                                    <!-- Prompt (columna 1 de 2 → en realidad lo movemos a la columna 1) -->
                                                                    <TextBlock Grid.Column="0"
               Text="{Binding PromptCmdCorto}"
               ToolTip="{Binding DirectorioTrabajo}"
               Style="{StaticResource CmdPromptTexto}"
               VerticalAlignment="Top"
               Margin="24,2,8,2"/>

                                                                    <!-- Comando: TextBox que envuelve -->
                                                                    <TextBox Grid.Column="1"
             x:Name="TextoEdicion"
             FontFamily="Consolas"
             FontSize="14"
             Foreground="{StaticResource CmdTexto}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             Margin="0,2,0,2"
             TextWrapping="Wrap"
             AcceptsReturn="False"
             VerticalScrollBarVisibility="Disabled"
             CaretBrush="{StaticResource CmdTexto}"
             Text="{Binding Texto, Mode=OneWay}"
             IsUndoEnabled="False"                                                         
             Visibility="Collapsed"
             PreviewKeyDown="EditorComando_PreviewKeyDown"
             LostFocus="EditorComando_LostFocus"
             IsVisibleChanged="EditorComando_IsVisibleChanged"/>

                                                                    <!-- Texto de lectura (modo no activo) -->
                                                                    <TextBlock Grid.Column="1"
               x:Name="TextoLectura"
               Text="{Binding Texto}"
               FontFamily="Consolas"
               FontSize="14"
               Foreground="{StaticResource CmdTexto}"
               TextWrapping="Wrap"
               Margin="0,2,0,2"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Borde inferior animado -->
                                                            <Border x:Name="BordeInferior"
                        Grid.Row="2"
                        Height="2"
                        Background="{StaticResource CmdAcento}"
                        HorizontalAlignment="Center"
                        Width="0"/>
                                                        </Grid>

                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                <!-- Contenedor -->
                                                                <Setter TargetName="LineaContenedor" Property="Background" Value="#FF181818"/>
                                                                <Setter TargetName="LineaContenedor" Property="BorderBrush" Value="{StaticResource CmdAcento}"/>

                                                         

                                                                <!-- Intercambio lectura/edición -->
                                                                <Setter TargetName="TextoLectura" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="TextoEdicion" Property="Visibility" Value="Visible"/>

                                                                <!-- Bordes animados -->
                                                                <Setter TargetName="BordeSuperior" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="BordeInferior" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Editor de la línea activa -->
                                           

                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="3"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"            
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

            <GridSplitter Grid.Column="3" 
              Width="5"
              Style="{StaticResource SplitterVertical}" 
              ResizeDirection="Columns"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

            <!-- Panel derecho -->
        <Grid Grid.Column="4" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="140"/>
                <!-- Modificadores -->
                <RowDefinition Height="5"/>
                <RowDefinition Height="1.5*" MinHeight="120"/>
                <!-- Operadores -->
                <RowDefinition Height="5"/>
                <RowDefinition Height="1*" MinHeight="120"/>
                <!-- Ayuda -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Pane}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                                   Text="MODIFICADORES DEL COMANDO"
                                   Style="{StaticResource SectionHeader}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <CheckBox Content="/S  · Incluir subdirectorios"    Margin="0,3"/>
                            <CheckBox Content="/B  · Formato simple"            Margin="0,3"/>
                            <CheckBox Content="/A  · Atributos"                 Margin="0,3"/>
                            <CheckBox Content="/O  · Ordenar"                   Margin="0,3"/>
                            <CheckBox Content="/W  · Formato ancho"             Margin="0,3"/>
                            <CheckBox Content="/P  · Pausa por pantalla"        Margin="0,3"/>
                            <CheckBox Content="/Q  · Silencioso"                Margin="0,3"/>
                            <CheckBox Content="/R  · Reintentar en error"       Margin="0,3"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"                
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

            <Border Grid.Row="2" Style="{StaticResource Pane}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                                   Text="OPERADORES · VARIABLES · CONSTANTES"
                                   Style="{StaticResource SectionHeader}"/>
                    <TabControl Margin="4,2">
                                    <TabItem>
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📝" Margin="0,0,4,0"/>
                                                <TextBlock Text="Texto"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Inserta un token de texto libre:"
                   FontSize="11"
                   Foreground="#FF666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
                                            <Button Content="📝 Insertar texto"
                Padding="10,6"
                FontSize="12"
                FontWeight="SemiBold"
                HorizontalAlignment="Left"
                Click="AgregarTexto_Click"
                ToolTip="Añade un token de texto editable (nombres de archivo, cadenas de búsqueda, mensajes...)"/>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Operadores">
                            <WrapPanel Margin="6">
                                <Button Content="&amp;"    Style="{StaticResource OpButton}"/>
                                <Button Content="&amp;&amp;" Style="{StaticResource OpButton}"/>
                                <Button Content="||"   Style="{StaticResource OpButton}"/>
                                <Button Content="|"    Style="{StaticResource OpButton}"/>
                                <Button Content="&gt;"    Style="{StaticResource OpButton}"/>
                                <Button Content="&gt;&gt;" Style="{StaticResource OpButton}"/>
                                <Button Content="&lt;"    Style="{StaticResource OpButton}"/>
                                <Button Content="^"    Style="{StaticResource OpButton}"/>
                                <Button Content="%"    Style="{StaticResource OpButton}"/>
                                <Button Content="=="   Style="{StaticResource OpButton}"/>
                                <Button Content="NEQ"  Style="{StaticResource OpButton}"/>
                                <Button Content="EQU"  Style="{StaticResource OpButton}"/>
                                <Button Content="▶ Ejecutar" Padding="8,2" ToolTip="Ejecutar la línea actual"
        Click="Ejecutar_Click"
        IsEnabled="{Binding EstaEjecutando, Converter={StaticResource InverseBoolConverter}}"/>

<Button Content="⏹ Detener" Padding="8,2" ToolTip="Detener el proceso en curso"
        Click="Detener_Click"
        IsEnabled="{Binding EstaEjecutando}"/>
                            </WrapPanel>
                        </TabItem>
                        
                        <TabItem Header="Variables">
                            <ListBox Margin="4">
                                <ListBoxItem Content="%USERPROFILE%"/>
                                <ListBoxItem Content="%TEMP%"/>
                                <ListBoxItem Content="%PATH%"/>
                                <ListBoxItem Content="%DATE%"/>
                                <ListBoxItem Content="%TIME%"/>
                                <ListBoxItem Content="%RANDOM%"/>
                                <ListBoxItem Content="%ERRORLEVEL%"/>
                                <ListBoxItem Content="%CD%"/>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Constantes">
                            <ListBox Margin="4">
                                <ListBoxItem Content="CON"/>
                                <ListBoxItem Content="NUL"/>
                                <ListBoxItem Content="PRN"/>
                                <ListBoxItem Content="AUX"/>
                                <ListBoxItem Content="COM1"/>
                                <ListBoxItem Content="LPT1"/>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Comodines">
                            <ListBox Margin="4">
                                <ListBoxItem Content="*      · Cualquier secuencia"/>
                                <ListBoxItem Content="?      · Un carácter"/>
                                <ListBoxItem Content="[abc]  · Conjunto"/>
                                <ListBoxItem Content="[a-z]  · Rango"/>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="3"
              Height="5"
              Style="{StaticResource SplitterHorizontal}"               
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True"/>

            <Border Grid.Row="4" Style="{StaticResource Pane}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                                   Text="AYUDA CONTEXTUAL"
                                   Style="{StaticResource SectionHeader}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TextoAyuda"
                                   Margin="8" TextWrapping="Wrap"
                                   Foreground="#FF333333"
                                   Text="{Binding TextoAyuda}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
            </Grid>

            <!-- Splitter horizontal -->
            <GridSplitter Grid.Row="1"
                  Height="5"
                  Style="{StaticResource SplitterHorizontal}"/>

            <!-- Panel inferior: comentarios, errores, salida, historial -->
            <Border Grid.Row="2"
            BorderBrush="#FFC8C8C8" BorderThickness="0,1,0,0"
            Background="White">
                <TabControl>
                    <TabItem Header="💬 Comentarios">
                        <TextBox x:Name="TextoComentarios" AcceptsReturn="True"
                         Margin="4" Padding="6"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
                    </TabItem>
                    <TabItem Header="⚠ Errores">
                        <DataGrid x:Name="GridErrores" Margin="4" AutoGenerateColumns="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravedad" Binding="{Binding Severidad}" Width="90"/>
                                <DataGridTextColumn Header="Mensaje"  Binding="{Binding Mensaje}"   Width="*"/>
                                <DataGridTextColumn Header="Línea"    Binding="{Binding Linea}"     Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="📤 Salida">
                        <ListBox x:Name="ListaSalida"
             ItemsSource="{Binding Salida}"
             Background="#FF0C0C0C"
             Foreground="#FFDCDCDC"
             FontFamily="Consolas"
             FontSize="12"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFDCDCDC"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                           FontFamily="Consolas"
                           TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="🕘 Historial">
                        <ListBox x:Name="ListaHistorial" Margin="4"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    
    </DockPanel>
    
</Window>