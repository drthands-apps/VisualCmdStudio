<Window x:Class="VisualCommander.DialogoExportarSh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar como script Bash"
        Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="16,6" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancelar_Click"/>
                <Button Content="💾 Exportar" Padding="16,6"
                        Background="#FF1F4E79" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0"
                        Click="Exportar_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Ubicación del archivo:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRuta" Grid.Column="0" Padding="6,4"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="📂 Examinar..."
                            Margin="6,0,0,0" Padding="10,4"
                            Click="Examinar_Click"/>
                </Grid>

                <Border Background="#FFFFE8E8"
                        BorderBrush="#FFE8A5A5"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#FF8B2015">
                        <Run Text="⚠ " FontWeight="Bold"/>
                        <Run Text="Este script contiene comandos de Windows."/>
                        <LineBreak/>
                        <Run Text="NO se ejecutará directamente en Bash sin traducir."/>
                        <LineBreak/>
                        <Run Text="Requiere WSL, Git Bash, o traducción manual."/>
                    </TextBlock>
                </Border>

                <TextBlock Text="Opciones:" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <CheckBox x:Name="ChkCabecera" IsChecked="True"
                          Content="Incluir cabecera con metadatos"
                          Margin="0,2"/>
                <CheckBox x:Name="ChkAdvertencia" IsChecked="True"
                          Content="Incluir advertencia sobre comandos de Windows"
                          Margin="0,2"/>
                <CheckBox x:Name="ChkDirectorio" IsChecked="True"
                          Content="Incluir comentario con el directorio de trabajo"
                          Margin="0,2"/>

                <TextBlock Text="Vista previa:" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <Border Background="#FF1E1E1E" Padding="10" CornerRadius="3" Height="100">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtPreview"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#FFDCDCDC"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>