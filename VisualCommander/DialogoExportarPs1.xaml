<Window x:Class="VisualCommander.DialogoExportarPs1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar como script PowerShell"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- Botonera inferior -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="16,6" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancelar_Click"/>
                <Button Content="💾 Exportar" Padding="16,6"
                        Background="#FF1F4E79" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0"
                        Click="Exportar_Click"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Ubicación -->
                <TextBlock Text="Ubicación del archivo:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRuta" Grid.Column="0" Padding="6,4"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="📂 Examinar..."
                            Margin="6,0,0,0" Padding="10,4"
                            Click="Examinar_Click"/>
                </Grid>

                <!-- Aviso importante -->
                <Border Background="#FFFFF8E1"
                        BorderBrush="#FFE8C48A"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#FF8B4513">
                        <Run Text="⚠ " FontWeight="Bold"/>
                        <Run Text="Windows bloquea los scripts .ps1 por defecto."/>
                        <LineBreak/>
                        <Run Text="El script incluirá una cabecera con instrucciones"/>
                        <LineBreak/>
                        <Run Text="para ejecutarlo con Set-ExecutionPolicy."/>
                    </TextBlock>
                </Border>

                <!-- Opciones -->
                <TextBlock Text="Opciones:" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <CheckBox x:Name="ChkCabecera" IsChecked="True"
                          Content="Incluir cabecera con metadatos (fecha, usuario, equipo)"
                          Margin="0,2"/>
                <CheckBox x:Name="ChkAdvertencia" IsChecked="True"
                          Content="Incluir advertencia sobre la política de ejecución"
                          Margin="0,2"/>
                <CheckBox x:Name="ChkDirectorio" IsChecked="True"
                          Content="Incluir comentario con el directorio de trabajo (Set-Location)"
                          Margin="0,2"/>
                <CheckBox x:Name="ChkPausa" IsChecked="False"
                          Content="Incluir Read-Host al final (pausa antes de cerrar)"
                          Margin="0,2"/>

                <!-- Vista previa -->
                <TextBlock Text="Vista previa (primeras líneas):" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <Border Background="#FF1E1E1E" Padding="10" CornerRadius="3" Height="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtPreview"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#FFDCDCDC"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>