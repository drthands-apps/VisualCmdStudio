<Window x:Class="VisualCommander.DialogoExportarBat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar como archivo batch"
        Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- Botonera inferior -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="16,6" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancelar_Click"/>
                <Button Content="💾 Exportar" Padding="16,6"
                        Background="#FF1F4E79" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0"
                        Click="Exportar_Click"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <StackPanel>

            <!-- Ubicación -->
            <TextBlock Text="Ubicación del archivo:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRuta" Grid.Column="0" Padding="6,4"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="📂 Examinar..."
                        Margin="6,0,0,0" Padding="10,4"
                        Click="Examinar_Click"/>
            </Grid>

            <!-- Codificación -->
            <TextBlock Text="Codificación:" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <RadioButton x:Name="RbUtf8" Content="UTF-8 con BOM (recomendado, soporta acentos)"
                         IsChecked="True" Margin="0,2"/>
            <RadioButton x:Name="RbAnsi" Content="ANSI (Windows-1252, para CMD antiguo)"
                         Margin="0,2"/>

            <!-- Opciones -->
            <TextBlock Text="Opciones:" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <CheckBox x:Name="ChkCabecera" IsChecked="True"
                      Content="Incluir cabecera con metadatos (fecha, usuario, directorio)"
                      Margin="0,2"/>
            <CheckBox x:Name="ChkPause" IsChecked="True"
                      Content="Incluir 'pause' al final (mantiene la ventana abierta)"
                      Margin="0,2"/>

            <!-- Vista previa -->
            <TextBlock Text="Vista previa (primeras líneas):" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <Border Background="#FF1E1E1E" Padding="10" CornerRadius="3" Height="80">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtPreview"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#FFDCDCDC"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </DockPanel>
</Window>