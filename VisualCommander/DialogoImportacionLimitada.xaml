<Window x:Class="VisualCommander.DialogoImportacionLimitada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importación con soporte limitado"
        Icon="visualcmdstudio.ico"
        Width="520" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0"
                   FontSize="14" FontWeight="Bold"
                   Foreground="#FF1F4E79"
                   Text="Soporte limitado para este formato"/>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap"/>
        </ScrollViewer>

        <CheckBox x:Name="ChkNoVolver" Grid.Row="2"
                  Content="No volver a mostrar este aviso"
                  Margin="0,0,0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancelar_Click"/>
            <Button Content="Importar como texto" Width="150"
                    IsDefault="True" Click="Importar_Click"/>
        </StackPanel>
    </Grid>
</Window>