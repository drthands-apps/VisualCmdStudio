<Window x:Class="VisualCommander.ConfirmarPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmación de ejecución del plan"
        Width="760" Height="600"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="#FFC0392B" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="24" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONFIRMACIÓN — PLAN CON COMANDOS PELIGROSOS"
                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitulo"
                               FontSize="11" Foreground="#FFFFE0E0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#FFEDEDED"
                BorderBrush="#FFD0D0D0"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <CheckBox x:Name="ChkNoPreguntar"
                          Content="No volver a preguntar para estas líneas en esta sesión"
                          VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="❌ Cancelar" Padding="16,6" Margin="0,0,8,0"
                            IsCancel="True" Click="Cancelar_Click"/>
                    <Button Content="✅ Ejecutar el plan completo"
                            Padding="16,6"
                            Background="#FFC0392B" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0"
                            Click="Ejecutar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Sección 1: Líneas peligrosas -->
                <TextBlock x:Name="TituloPeligrosas"
                   Text="LÍNEAS PELIGROSAS DEL PLAN:"
                   FontWeight="SemiBold" FontSize="11"
                   Foreground="#FFC0392B"
                   Margin="0,0,0,8"/>
                <ItemsControl x:Name="ListaLineasPeligrosas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFF4F4"
                            BorderBrush="#FFE8A5A5"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10"
                            Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Encabezado}"
                                       FontWeight="SemiBold"
                                       Foreground="#FF8B2015"
                                       Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Directorio}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#FF8B4513"
                                       Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Comando}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Efectos}"
                                       FontSize="11"
                                       Foreground="#FF444444"
                                       TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sección 2: Líneas incompletas -->
                <TextBlock x:Name="TituloIncompletas"
                   Text="LÍNEAS INCOMPLETAS (faltan argumentos obligatorios):"
                   FontWeight="SemiBold" FontSize="11"
                   Foreground="#FFE67E22"
                   Margin="0,16,0,8"/>
                <ItemsControl x:Name="ListaLineasIncompletas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFF8E1"
                            BorderBrush="#FFE8C48A"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10"
                            Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Encabezado}"
                                       FontWeight="SemiBold"
                                       Foreground="#FF8B4513"
                                       Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Comando}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding DummiesFaltantes}"
                                       FontSize="11"
                                       Foreground="#FF666666"
                                       TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>